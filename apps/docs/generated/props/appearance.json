        {
          "name": "cookieWriteKey",
          "type": "string | false",
          "required": false,
          "defaultValue": "false",
          "description": "Optional state cookie for SSR and first-paint seeding. The cookie is written\nfrom the active client state for the next request; during client hydration it\nis NOT read — `localStorage` (when `storageKey` is enabled) wins. This keeps\nthe SSR paint stable: the server renders from the cookie, the client then\nadopts the local snapshot without a flash. Consumers who seed only the\ncookie (no `storageKey`, or a fresh device with no localStorage) will hydrate\nfrom `defaultState` and paint with whatever the server did not override."
        },
        {
          "name": "defaultState",
          "type": "NexusAppearanceState",
          "required": false,
          "defaultValue": null,
          "description": ""
        },
        {
          "name": "onStateChange",
          "type": "((state: NexusAppearanceState) => void)",
          "required": false,
          "defaultValue": null,
          "description": ""
        },
        {
          "name": "state",
          "type": "NexusAppearanceState",
          "required": false,
          "defaultValue": null,
          "description": ""
        },
        {
          "name": "storageKey",
          "type": "string | false",
          "required": false,
          "defaultValue": "nexus-appearance",
          "description": "Client snapshot storage. When enabled, the local snapshot is read after\nmount and is the client-side source of truth — it takes precedence over the\nSSR-seeded cookie and `defaultState`. Disable with `false` to make the\nprovider cookie/SSR-driven only."
        }
      ]
