{
  "name": "@nxds/docs",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "description": "Documentation site for the nxds design system",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n demos,next -c gray,cyan \"pnpm generate:demos:watch\" \"next dev --turbopack\"",
    "generate:props": "node scripts/generate-props.mjs",
    "generate:vue": "node scripts/generate-vue-docs.ts",
    "bundle:vue": "node scripts/bundle-vue-demos.ts",
    "build": "next build && node scripts/write-edge-files.mjs && node scripts/write-markdown.ts && node scripts/write-registry.mjs",
    "generate:manifest": "node scripts/generate-page-manifest.mjs",
    "audit:csp": "node scripts/audit-csp-inventory.mjs",
    "generate:demos": "node scripts/generate-demo-index.mjs",
    "generate:demos:watch": "node scripts/generate-demo-index.mjs --watch",
    "audit:grammar-pin": "node scripts/audit-grammar-pin.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "clean": "rm -rf .next out generated __generated__ public/vue-demos app/_lib/*.generated.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.6",
    "@nxds/catalog": "workspace:*",
    "@nxds/core": "workspace:*",
    "@nxds/react": "workspace:*",
    "@nxds/tailwind": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@shikijs/langs": "4.4.3",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-form": "^1.33.5",
    "next": "^15.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.77.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.2.4",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "react-docgen-typescript": "^2.4.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "^7.3.5",
    "vue": "^3.5.44",
    "vue-component-meta": "3.3.13"
  }
}
