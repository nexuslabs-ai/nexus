{
  "name": "@nexus_ds/docs",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Documentation site for the Nexus Design System",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n demos,next -c gray,cyan \"pnpm generate:demos:watch\" \"next dev --turbopack\"",
    "generate:props": "node scripts/generate-props.mjs",
    "generate:dependencies": "node scripts/generate-dependencies.mjs",
    "build": "next build",
    "start": "next start",
    "generate:manifest": "node scripts/generate-page-manifest.mjs",
    "audit:csp": "node scripts/audit-csp-inventory.mjs",
    "generate:demos": "node scripts/generate-demo-index.mjs",
    "generate:demos:watch": "node scripts/generate-demo-index.mjs --watch",
    "audit:grammar-pin": "node scripts/audit-grammar-pin.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next generated"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.6",
    "@nexus_ds/core": "workspace:*",
    "@nexus_ds/react": "workspace:*",
    "@nexus_ds/tailwind": "workspace:*",
    "@shikijs/langs": "4.4.3",
    "@tabler/icons-react": "^3.36.1",
    "next": "^15.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "4.3.0",
    "concurrently": "^9.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "react-docgen-typescript": "^2.4.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3"
  }
}
