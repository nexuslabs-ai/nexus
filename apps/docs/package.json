{
  "name": "@nexus_ds/docs",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Documentation site for the Nexus Design System",
  "scripts": {
    "dev": "pnpm generate:manifest && node scripts/dev-create.mjs",
    "build": "pnpm generate:manifest && pnpm generate:catalog && next build",
    "start": "next start",
    "generate:manifest": "node scripts/generate-page-manifest.mjs",
    "audit:csp": "node scripts/audit-csp-inventory.mjs",
    "audit:grammar-pin": "node scripts/audit-grammar-pin.mjs",
    "typecheck": "pnpm generate:catalog && tsc --noEmit",
    "clean": "rm -rf .next dist",
    "generate:catalog": "node scripts/generate-create-catalog.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.6",
    "@nexus_ds/core": "workspace:*",
    "@nexus_ds/react": "workspace:*",
    "@nexus_ds/tailwind": "workspace:*",
    "@shikijs/langs": "4.4.3",
    "@tabler/icons-react": "^3.36.1",
    "next": "^15.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "embla-carousel-react": "^8.6.0",
    "react-day-picker": "^9",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
