{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:demos": {
      "dependsOn": ["generate:dependencies", "generate:props"],
      "outputs": ["__generated__/**", "public/avatars/**"],
      "cache": false
    },
    "generate:props": {
      "dependsOn": ["^build"],
      "inputs": [
        "scripts/generate-props.mjs",
        "scripts/props-contract.mjs",
        "scripts/props-entries.mjs",
        "scripts/react-entry-points.mjs",
        "scripts/react-sources.mjs",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/react/tsconfig.json"
      ],
      "outputs": ["generated/props/**"]
    },
    "generate:dependencies": {
      "inputs": [
        "scripts/generate-dependencies.mjs",
        "scripts/react-sources.mjs",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/react/tsconfig.json"
      ],
      "outputs": ["generated/dependencies/**"]
    },
    "generate:manifest": {
      "inputs": [
        "scripts/generate-page-manifest.mjs",
        "scripts/page-manifest.mjs",
        "scripts/roots.mjs",
        "scripts/humanize.mjs",
        "scripts/docs-stories.mjs",
        "scripts/react-sources.mjs",
        "page-registry/**",
        "content/**",
        "app/_pages/**",
        "$TURBO_ROOT$/packages/react/src/index.ts",
        "$TURBO_ROOT$/packages/react/src/components/**/*.tsx",
        "$TURBO_ROOT$/.prettierrc"
      ],
      "outputs": [
        "app/_lib/page-manifest.generated.ts",
        "app/_lib/page-content.generated.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate:manifest",
        "generate:props",
        "generate:dependencies",
        "generate:demos"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"],
      "outputs": ["out/**", "next-env.d.ts"]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "generate:manifest",
        "generate:props",
        "generate:dependencies",
        "generate:demos"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate:manifest", "generate:demos"]
    }
  }
}
