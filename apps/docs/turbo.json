{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:demos": {
      "inputs": ["examples/**", "scripts/generate-demo-index.mjs"],
      "outputs": ["__generated__/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate:demos"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate:demos"]
    }
  }
}
