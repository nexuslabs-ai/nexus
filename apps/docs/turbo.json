{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:demos": {
      "outputs": ["__generated__/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate:demos"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate:demos"]
    }
  }
}
