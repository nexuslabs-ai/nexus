{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:demos": {
      "dependsOn": ["generate:props"],
      "outputs": ["__generated__/**", "public/avatars/**"],
      "cache": false
    },
    "generate:props": {
      "dependsOn": ["@nxds/core#build"],
      "inputs": [
        "scripts/generate-props.mjs",
        "scripts/props-contract.mjs",
        "scripts/props-entries.ts",
        "scripts/react-entry-points.mjs",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/scripts/files.mjs",
        "$TURBO_ROOT$/packages/react/scripts/humanize.ts",
        "$TURBO_ROOT$/packages/react/scripts/react-sources.mjs",
        "$TURBO_ROOT$/packages/react/scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/react/package.json",
        "$TURBO_ROOT$/packages/react/tsconfig.json"
      ],
      "outputs": ["generated/props/**"]
    },
    "generate:vue": {
      "inputs": [
        "scripts/generate-vue-docs.ts",
        "scripts/props-contract.mjs",
        "scripts/props-entries.ts",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/scripts/files.mjs",
        "$TURBO_ROOT$/packages/react/scripts/humanize.ts",
        "$TURBO_ROOT$/packages/react/scripts/install-plans.ts",
        "$TURBO_ROOT$/packages/react/scripts/roots.mjs",
        "$TURBO_ROOT$/packages/vue/scripts/**",
        "$TURBO_ROOT$/packages/vue/src/**",
        "$TURBO_ROOT$/packages/vue/package.json",
        "$TURBO_ROOT$/packages/vue/tsconfig.json",
        "$TURBO_ROOT$/.prettierrc"
      ],
      "outputs": ["generated/vue/**"]
    },
    "bundle:vue": {
      "dependsOn": ["@nxds/core#build", "generate:vue"],
      "inputs": [
        "scripts/bundle-vue-demos.ts",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/scripts/roots.mjs",
        "generated/vue/**",
        "$TURBO_ROOT$/packages/vue/src/**"
      ],
      "outputs": ["public/vue-demos/**"]
    },
    "generate:manifest": {
      "inputs": [
        "scripts/generate-page-manifest.mjs",
        "scripts/page-manifest.mjs",
        "scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/scripts/files.mjs",
        "$TURBO_ROOT$/packages/react/scripts/humanize.ts",
        "$TURBO_ROOT$/packages/react/scripts/react-sources.mjs",
        "$TURBO_ROOT$/packages/react/scripts/roots.mjs",
        "$TURBO_ROOT$/packages/react/scripts/stories.ts",
        "page-registry/**",
        "content/**",
        "app/_pages/**",
        "$TURBO_ROOT$/packages/react/src/index.ts",
        "$TURBO_ROOT$/packages/react/src/components/**/*.tsx",
        "$TURBO_ROOT$/packages/react/src/blocks/**",
        "$TURBO_ROOT$/packages/react/src/lib/**",
        "$TURBO_ROOT$/.prettierrc"
      ],
      "outputs": [
        "app/_lib/page-manifest.generated.ts",
        "app/_lib/page-content.generated.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate:manifest",
        "generate:props",
        "generate:demos",
        "generate:vue",
        "bundle:vue",
        "@nxds/react#generate:catalog"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"],
      "outputs": ["out/**", "next-env.d.ts"]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "generate:manifest",
        "generate:props",
        "generate:demos",
        "generate:vue",
        "bundle:vue",
        "@nxds/react#generate:catalog"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "@nxds/core#build",
        "@nxds/react#build",
        "generate:manifest",
        "generate:demos",
        "generate:vue",
        "@nxds/react#generate:catalog"
      ]
    }
  }
}
