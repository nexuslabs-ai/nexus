{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-storybook",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./storybook-static",
    "html_handling": "none",
  },
  "routes": [{ "pattern": "storybook.nexusui.so", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
