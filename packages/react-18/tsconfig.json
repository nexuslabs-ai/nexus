{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../react/tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    // Radix and the other dependencies sit in the root node_modules, beside
    // @types/react 19. Point every `react` import at this package's 18 types.
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src/**/*", ".storybook/**/*"],
  "exclude": ["node_modules", "storybook-static"]
}
