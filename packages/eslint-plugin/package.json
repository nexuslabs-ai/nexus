{
  "name": "@nxds/eslint-plugin",
  "version": "0.4.0",
  "type": "module",
  "description": "ESLint rules that enforce Nexus UI conventions in copied components.",
  "keywords": [
    "nexus-ui",
    "design-system",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwindcss"
  ],
  "homepage": "https://nxds.dev/getting-started/install#optional-add-lint-rules",
  "bugs": {
    "url": "https://github.com/nexuslabs-ai/nxds/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexuslabs-ai/nxds.git",
    "directory": "packages/eslint-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./tailwind": "./src/tailwind.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "refresh:canonical-set": "node scripts/refresh-canonical-set.js"
  },
  "dependencies": {
    "jsonc-eslint-parser": "^3.1.0"
  },
  "devDependencies": {
    "eslint-plugin-better-tailwindcss": "^4.7.0"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    }
  },
  "license": "MIT"
}
