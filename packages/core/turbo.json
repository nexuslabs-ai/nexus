{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tokens/primitives/color.json",
        "tsup.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/runtime/**"]
    }
  }
}
