{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "tokens/**", "tsup.config.ts", "tsconfig.json"],
      "outputs": ["dist/runtime/**", "dist/scripts/**"]
    },
    "build:tailwind": {
      "dependsOn": ["build"],
      "inputs": ["scripts/**", "tokens/**"],
      "outputs": ["dist/tailwind/**"]
    },
    "audit:colorblind": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
